{
  "name": "engineering-education-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm data:build && vite --host 127.0.0.1",
    "build": "pnpm data:build && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:validate": "tsx scripts/data.ts validate",
    "data:build": "tsx scripts/data.ts build",
    "sync:import": "tsx scripts/sync.ts import",
    "sync:preview": "tsx scripts/sync.ts preview",
    "sync:apply": "tsx scripts/sync.ts apply",
    "export:kn": "tsx scripts/export-kn.ts",
    "export:verify": "tsx scripts/export-kn.ts --verify",
    "sync:demo": "tsx scripts/demo-sync.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@mieweb/ui": "^0.11.0",
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.20.0",
    "js-yaml": "^5.5.0",
    "lucide-react": "^1.61.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
